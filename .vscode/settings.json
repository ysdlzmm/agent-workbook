{
  // ---------------- Python 环境 ----------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.exclude": ["**/.venv", "**/__pycache__"],

  // ---------------- 编辑器基线 ----------------
  // detectIndentation 必须关掉：否则 VSCode 会按文件里残留的 tab 自动切回制表符
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.formatOnSave": true,
  // 用户级是 modificationsIfAvailable（局部格式化），这里强制整文件格式化
  "editor.formatOnSaveMode": "file",
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ---------------- 语言级覆盖（冲突时 Python 优先）----------------
  // 优先级高于全局 Prettier / prettier-eslint：.py 一律交给 Black
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },

  // Black：用扩展自带二进制，不依赖 .venv 里是否装了 black
  // 注意合法值是 useBundled（不是 bundled），写错会显示设置无效
  "black-formatter.importStrategy": "useBundled",
  "black-formatter.args": ["--line-length=88"],
  // 默认 off：格式化失败时完全静默。打开后语法错误会弹通知，便于定位
  "black-formatter.showNotifications": "onError",

  // ---------------- 关闭重复诊断 ----------------
  // 状态栏那个 "Pylint: 0.00/10" 就是它，和 Pylance 会重复报错
  "pylint.enabled": false,
  "flake8.enabled": false,

  // ---------------- 拼写检查白名单 ----------------
  // 否则 TAVILY / dotenv 等会被标 "Unknown word"
  "cSpell.words": [
    "tavily",
    "serpapi",
    "dotenv",
    "pylance",
    "pyright",
    "pylint",
    "llm"
  ],

  // ---------------- 屏蔽虚拟环境噪声 ----------------
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  }
}
