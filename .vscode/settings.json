{
  // ---------------- Python 环境 ----------------
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.terminal.activateEnvironment": true,
  "python.analysis.autoImportCompletions": true,
  "python.analysis.typeCheckingMode": "basic",
  "python.analysis.exclude": ["**/.venv", "**/__pycache__"],

  // ---------------- 编辑器基线 ----------------
  // detectIndentation 必须关掉：否则 VSCode 会按文件里残留的 tab 自动切回制表符
  "editor.detectIndentation": false,
  "editor.insertSpaces": true,
  "editor.tabSize": 4,
  "editor.formatOnSave": true,
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.eol": "\n",

  // ---------------- 语言级覆盖（冲突时 Python 优先）----------------
  // 优先级高于全局 Prettier / prettier-eslint：.py 一律交给 Black
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.formatOnSave": true,
    "editor.detectIndentation": false,
    "editor.insertSpaces": true,
    "editor.tabSize": 4
  },

  // Black：用扩展自带二进制，不依赖 .venv 里是否装了 black
  "black-formatter.importStrategy": "bundled",
  "black-formatter.args": ["--line-length=88"],

  // ---------------- 关闭重复诊断 ----------------
  // 状态栏那个 "Pylint: 0.00/10" 就是它，和 Pylance 会重复报错
  "pylint.enabled": false,
  "flake8.enabled": false,

  // ---------------- 屏蔽虚拟环境噪声 ----------------
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true
  },
  "search.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/__pycache__/**": true
  }
}
