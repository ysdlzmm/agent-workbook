# .env.example
# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿把真实密钥提交到仓库

# 大模型服务的 API Key（必填）
LLM_API_KEY=your_api_key_here

# 模型 ID（必填），例如智谱 glm-4-flash
LLM_MODEL_ID=glm-4-flash

# 兼容 OpenAI 协议的服务地址（必填），例如智谱开放平台
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 请求超时时间，单位秒（可选，默认 60）
LLM_TIMEOUT=60

# 网页搜索服务（Tavily）
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

DASHSCOPE_API_KEY='YOUR_DASHSCOPE_API_KEY'
