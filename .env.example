# .env.example
# 复制为 .env 后填入真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 排除，切勿把真实密钥提交到仓库

# 大模型服务的 API Key（必填）
LLM_API_KEY=your_api_key_here

# 模型 ID（必填），例如智谱 glm-4-flash
LLM_MODEL_ID=glm-4-flash

# 兼容 OpenAI 协议的服务地址（必填），例如智谱开放平台
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 请求超时时间，单位秒（可选，默认 60）
LLM_TIMEOUT=60

# 网页搜索服务（Tavily）
TAVILY_API_KEY="YOUR_TAVILY_API_KEY"

# ------------------------------------------------------------
# chapter5 / CAMEL 示例：模型服务选择
#   zhipu（默认）-> 用上面的 LLM_* 三个变量，glm-4-flash 免费
#   qwen         -> 用下面三个 DASHSCOPE / QWEN_* 变量
# 两套服务的密钥、地址、模型名不要混用。
# 阿里百炼账户欠费或免费额度耗尽时，qwen 会返回 400 overdue-payment，
# 此时保持 zhipu 即可；账户恢复后再切成 qwen。
# ------------------------------------------------------------
LLM_PROVIDER=zhipu

# 以下三项仅在 LLM_PROVIDER=qwen 时生效
DASHSCOPE_API_KEY='YOUR_DASHSCOPE_API_KEY'

# 模型名（可选，默认 qwen-plus）
QWEN_MODEL=qwen-plus

# 兼容 OpenAI 协议的服务地址（可选，默认阿里百炼官方地址）
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
